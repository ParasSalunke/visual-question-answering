# Visual Question Answering App - Environment Configuration
# NEVER commit .env to version control! Keep your API keys private.

# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model Identifier (default: gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face User Access Token (get from https://huggingface.co/settings/tokens)
HF_TOKEN=

# Image Generation Provider: "hf" (sd-turbo via Inference API) or "gemini" (imagen-3.0-generate-001)
IMAGE_PROVIDER=hf

# Server Port (default: 7860 for Hugging Face Spaces compatibility)
PORT=7860
HOST=0.0.0.0
